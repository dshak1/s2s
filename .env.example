# Steppe to Screen — environment variables.
# The app runs fully without these (localStorage demo mode). Set them to wire up
# the real Supabase backend, then run the migrations in /supabase/migrations.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Password gate for /admin/content (defaults to "steppe" if unset).
NEXT_PUBLIC_ADMIN_PASSWORD=steppe

# Lite deployment: set to 1 to expose only Sound It Out + Greetings Quiz and hide
# the rest of the hub, journey, sessions, and facilitator tools. Leave unset for
# the full site.
NEXT_PUBLIC_LITE=
