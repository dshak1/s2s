# Steppe to Screen — environment variables.
# The app runs fully without these (localStorage demo mode). Set them to wire up
# the real Supabase backend, then run the migrations in /supabase/migrations.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Needed by the Linear webhook and AI ticket runs, which have no user session to act as.
SUPABASE_SERVICE_ROLE_KEY=

# Linear sync (optional). Without LINEAR_API_KEY the idea board works unchanged
# and the "File in Linear" button simply doesn't appear.
#   LINEAR_API_KEY        personal API key from Linear -> Settings -> API
#   LINEAR_TEAM_ID        which team to file into (defaults to your first team)
#   LINEAR_WEBHOOK_SECRET signing secret, for POST /api/linear/webhook
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=

# AI ticket investigation (optional). Staff can click "AI investigate" on a
# ticket only when the selected model key plus GitHub, Vercel, and Supabase
# service credentials are configured. The agent creates an isolated GitHub
# branch, records a case file, waits for the Vercel preview from Git integration,
# and emails AI_NOTIFY_EMAIL when done.
AI_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set to 1 for low-cost test runs if the selected Groq model rejects hosted
# web-search tools. The agent will still use ticket context, attachments, and
# repository files.
AI_DISABLE_WEB_SEARCH=
GITHUB_TOKEN=
GITHUB_REPOSITORY=dshak1/s2s
AI_BASE_BRANCH=feat/pro-infra
AI_PRODUCTION_BRANCH=feat/pro-infra
AI_PRODUCTION_URL=https://s2s-ten.vercel.app
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_PROJECT_NAME=s2s
AI_NOTIFY_EMAIL=
COMPOSIO_API_KEY=

# Email notifications use Resend. If AI_NOTIFY_EMAIL is empty, AI completion
# email falls back to the staff member who clicked the button.
RESEND_API_KEY=
EMAIL_FROM=

# ElevenLabs. Already used to generate the Kazakh TTS clips in /public/audio;
# the same key powers voice notes on the labelling queue (Scribe speech-to-text)
# via POST /api/transcribe. Without it, voice recordings are still saved to the
# private voice-notes bucket — only the transcript is skipped.
# It now also gates a kid-facing path: POST /api/say-check (the mic in
# say-and-shift) calls Scribe directly, anonymously, with no fallback — without
# this key the game's mic step is off and only the tap-fallback works.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# NEXT_PUBLIC_ADMIN_PASSWORD is no longer used — /admin and /facilitator are now
# gated by real team accounts (magic link). See supabase/migrations/0005_identity.sql.
# For sign-in links to work, add your deployment origins to the Supabase dashboard
# under Authentication -> URL Configuration -> Redirect URLs:
#   http://localhost:3100/auth/callback
#   https://s2s-ten.vercel.app/auth/callback

# Lite deployment: set to 1 to expose only Sound It Out + Greetings Quiz and hide
# the rest of the hub, journey, sessions, and facilitator tools. Leave unset for
# the full site.
NEXT_PUBLIC_LITE=

# Multiplayer/session features: set to 1 to enable /facilitator, /join, and the
# Say & Shift live race. Leave unset to show "coming soon" instead — these need
# real workshop testing before the public deploy offers them. No code change
# needed to flip this back on later, just the env var.
NEXT_PUBLIC_ONLINE_FEATURES=
